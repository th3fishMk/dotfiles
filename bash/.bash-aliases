#!/usr/bin/env bash

# System Management
alias reSource="source ~/.bashrc"
alias lll="ls -la --color=auto"

alias g="git"
alias gg="git status"
alias g-github="git remote add github"
alias g-codeberg="git remote add codeberg"
alias gl="git log --graph --oneline --decorate --all"
alias ga="git add"
alias gaa="git add --all"
alias gco="git checkout"
alias gb="git branch"
alias gdiscard="git restore ."

alias biomize="pnpm add -D -E @biomejs/biome && pnpx @biomejs/biome init"

alias dotfiles-update="cd \$HOME/.dotfiles && git pull && cd - && reSource"
alias dotfiles-update-force="cd \$HOME/.dotfiles && git fetch --all && git reset --hard origin/trunk && cd - && reSource"
alias dotfiles-cd="cd \$HOME/.dotfiles"

# Docker toggle aliases
alias dockon="sudo systemctl start docker.service"
alias dockoff="sudo systemctl stop docker.service docker.socket"
alias dockus="sudo systemctl status docker.service"
