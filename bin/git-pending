#!/usr/bin/env bash

# Prints the status of all the git repositories
# Inside a folder, if no folder is indicated
# It will default to the current directory

DIR=${1:-$(pwd)}

TERM_WIDTH=$(tput cols 2>/dev/null || echo 80)
SEPARATOR=$(printf '%*s' "$TERM_WIDTH" '' | tr ' ' '-')

echo "Scanning subdirectories in: $DIR"
echo "$SEPARATOR"

for repo in "$DIR"/*/; do
    repo_name=$(basename "${repo%/}")

    if [ ! -d "$repo/.git" ]; then
        printf "%-25s | \033[0;33mNot a Git repository\033[0m\n" "$repo_name"
        continue
    fi

    (
        cd "$repo" || exit
        statuses=()

        if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
            statuses+=("\033[0;33mEmpty repository (no commits)\033[0m")
        else
            if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
                statuses+=("\033[0;31mUncommitted/untracked changes\033[0m")
            fi

            if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
                unpushed_count=$(git rev-list --count @{u}..HEAD 2>/dev/null)
                if [ "${unpushed_count:-0}" -gt 0 ]; then
                    statuses+=("\033[0;31mUn-pushed commits ($unpushed_count ahead)\033[0m")
                fi
            fi
        fi
        if [ ${#statuses[@]} -eq 0 ]; then
            status_str="\033[0;32mclean\033[0m"
        else
            IFS=", "
            status_str="${statuses[*]}"
        fi

        printf "%-25s | %b\n" "$repo_name" "$status_str"
    )
done
